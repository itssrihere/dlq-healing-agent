{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipment event (test-only contract, proves a new topic needs no new Java)",
  "type": "object",
  "additionalProperties": false,
  "required": ["shipmentId", "orderRef", "carrier", "quantity", "shippedOn"],
  "properties": {
    "shipmentId": {"type": "string", "pattern": "^S-[0-9]{6}$"},
    "orderRef": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "carrier": {"type": "string", "enum": ["DHL", "UPS", "FEDEX"]},
    "quantity": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "A whole number of items, never text."},
    "shippedOn": {"type": "string", "format": "date", "description": "ISO-8601 calendar date such as 2025-04-03."}
  }
}
